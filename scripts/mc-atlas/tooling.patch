+    /** New clients replace some block-entity icons with ordinary item models (signs and beds in 26.3).
+     * Do not let the renderer's older hard-coded block-entity registry override those definitions. */
+    record ModelContext(RendererContext context, Set<String> items) {}
+
+    static ModelContext preferDeclaredItemModels(RendererContext context, Path jar, List<String> ids) throws IOException {
+        Set<String> modelItems = new HashSet<>();
+        Map<String, Item> itemOverrides = new HashMap<>();
+        try (ZipFile zip = new ZipFile(jar.toFile())) {
+            for (String id : ids) {
+                if (!context.findBlockEntityEntry(id).isPresent()) continue;
+                String definition = ITEM_DEFINITIONS_DIR + id.substring(VANILLA_NAMESPACE.length()) + ".json";
+                if (zip.getEntry(definition) == null) continue;
+                var entry = zip.getEntry(definition);
+                try (var input = zip.getInputStream(entry)) {
+                    var model = JsonParser.parseString(new String(input.readAllBytes(), java.nio.charset.StandardCharsets.UTF_8))
+                        .getAsJsonObject().getAsJsonObject("model");
+                    String type = model.get("type").getAsString();
+                    if (type.equals("minecraft:model")) {
+                        var parsed = context.findItemModel(model.get("model").getAsString());
+                        if (parsed.isPresent()) {
+                            var data = parsed.get();
+                            var textures = data.getTextures().entrySet().stream()
+                                .collect(Concurrent.toMap(Map.Entry::getKey, binding -> binding.getValue().sprite()));
+                            itemOverrides.put(id, new Item(ResourceId.parse(id), data, textures, 0,
+                                Concurrent.newUnmodifiableList(), false));
+                            modelItems.add(id);
+                        }
+                    } else if (type.equals("minecraft:composite") && !model.toString().contains("minecraft:special")) {
+                        modelItems.add(id);
+                    }
+                }
+            }
+        }
+        RendererContext preferred = new RendererContext.Forwarding() {
+            @Override public RendererContext delegate() { return context; }
+            @Override public Possible<Item> findItem(String id) {
+                return itemOverrides.containsKey(id) ? Possible.of(itemOverrides.get(id)) : context.findItem(id);
+            }
+            @Override public Possible<Block> findBlock(String id) {
+                return modelItems.contains(id) ? Possible.absent() : context.findBlock(id);
+            }
+            @Override public Possible<Block.BlockEntity> findBlockEntityEntry(String id) {
+                return modelItems.contains(id) ? Possible.absent() : context.findBlockEntityEntry(id);
+            }
+        };
+        return new ModelContext(preferred, Set.copyOf(modelItems));
+    }
